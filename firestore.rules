rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only authenticated users can read/write buildings they own.
    // For v1 single-admin: any authenticated user can access all buildings.
    match /buildings/{buildingId} {
      allow read, write: if request.auth != null;

      // Units subcollection — same rule, must be signed in
      match /units/{unitId} {
        allow read, write: if request.auth != null;
      }

      // Documents subcollection — property titles, utility bills, permits, etc.
      match /documents/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // Allow collection group queries on "units" and "documents"
    match /{path=**}/units/{unitId} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/documents/{docId} {
      allow read, write: if request.auth != null;
    }

    // Operations & Maintenance Suite
    match /staff/{staffId} {
      allow read, write: if request.auth != null;
    }
    match /errands/{errandId} {
      allow read, write: if request.auth != null;
    }
    match /maintenance/{ticketId} {
      allow read, write: if request.auth != null;
    }
    
    // User Settings Profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
