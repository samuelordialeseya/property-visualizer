rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Buildings ────────────────────────────────────────────────────────────
    match /buildings/{buildingId} {
      allow create: if request.auth != null
                    && request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if request.auth != null
                    && resource.data.user_id == request.auth.uid;
      // Units subcollection — verify ownership via parent building
      match /units/{unitId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/buildings/$(buildingId)).data.user_id == request.auth.uid;
      }
      // Documents subcollection
      match /documents/{docId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/buildings/$(buildingId)).data.user_id == request.auth.uid;
      }
    }
    // Collection group queries (still needed for cross-building unit queries)
    // We allow read for authenticated users, but JS-side filtering by user_id still applies.
    // The tighter per-building rules above cover writes.
    match /{path=**}/units/{unitId} {
      allow read: if request.auth != null
                  && resource.data.user_id == request.auth.uid;
      allow write: if request.auth != null
                   && request.resource.data.user_id == request.auth.uid;
    }
    match /{path=**}/documents/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // ── Operations & Maintenance ─────────────────────────────────────────────
    match /staff/{staffId} {
      allow create: if request.auth != null
                    && request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if request.auth != null
                    && resource.data.user_id == request.auth.uid;
    }
    match /errands/{errandId} {
      allow create: if request.auth != null
                    && request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if request.auth != null
                    && resource.data.user_id == request.auth.uid;
    }
    match /maintenance/{ticketId} {
      allow create: if request.auth != null
                    && request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if request.auth != null
                    && resource.data.user_id == request.auth.uid;
    }
    // ── User Settings Profile ────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
